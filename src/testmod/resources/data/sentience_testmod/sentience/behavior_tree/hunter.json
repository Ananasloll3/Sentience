          { "type": "move_to", "target": "focus_position", "speed": 1.1, "timeout": 300 },
          { "type": "search", "target": "focus_position", "radius": 6, "ticks": 160 },
          { "type": "give_up" }
        ]
      },
      {
        "name": "écouter",
        "type": "look_at",
        "target": "focus_position",
        "ticks": 40,
        "decorators": [ { "type": "awareness", "is": "suspicious", "abort": "lower" } ]
      },
      {
        "name": "patrouiller",
        "type": "sequence",
        "children": [
          { "type": "run_query", "query": "sentience_testmod:dark_spot", "result": "sentience_testmod:patrol_spot" },
          { "type": "move_to", "target": "sentience_testmod:patrol_spot", "speed": 0.7, "timeout": 300 },
