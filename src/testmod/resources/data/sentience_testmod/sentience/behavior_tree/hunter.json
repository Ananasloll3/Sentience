            ]
          },
          { "type": "attack", "target": "visible_target", "speed": 1.35, "cooldown": 20 }
        ]
      },
      {
        "name": "aller voir",
        "type": "sequence",
        "decorators": [ { "type": "awareness", "at_least": "investigate", "abort": "lower" } ],
