          { "type": "wait", "ticks": 80, "deviation": 20 }
        ]
      },
      {
        "name": "combattre",
        "type": "selector",
        "decorators": [ { "type": "sees_target", "abort": "both" } ],
        "services": [ { "type": "share_focus", "range": 32, "interval": 40 } ],
        "children": [
          {
            "name": "contourner",
            "type": "sequence",
            "decorators": [
              { "type": "distance", "target": "visible_target", "above": 5 },
              { "type": "cooldown", "ticks": 160 }
            ],
            "children": [
              { "type": "run_query", "query": "sentience:flank", "result": "sentience_testmod:flank_spot" },
